# ============================================================
# 诊所管理系统 · 忽略清单
#
# 最重要的一条：data/ 里是真实业务库（含患者、诊断、处方、收费），
# backups/ 是它的备份，logs/ 有管理员操作痕迹——**一律不得入库**。
# ============================================================

# ---- 运行时数据（含患者信息，绝不提交）----
data/
backups/
logs/

# ---- 本地工作笔记（含本机路径与过程记录）----
.workbuddy/

# ---- Python ----
__pycache__/
*.py[cod]
*.so
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
htmlcov/
.coverage
coverage.xml

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- 打包产物 ----
build/
dist/
*.spec

# ---- 临时文件 ----
*.tmp
*.bak
~$*
